# Loaded automatically by `npm run build:public` (vite build --mode public).
# Selects the public-marketing-site route tree in App.jsx.
VITE_BUILD_TARGET=public

# Fill in with the deployed ath-ai-server URL (e.g. Railway) before building
# for production. Defaults to http://localhost:8787 when left blank, which
# is only correct for local dev.
VITE_API_URL=https://backend-production-7a3e.up.railway.app
