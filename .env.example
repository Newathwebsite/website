# Base URL of the ath-ai-server backend (see ../ath-ai-server). Both the
# public build and the admin build point at the same deployed API — set this
# in whichever env file your host loads for each deploy (or a real .env
# alongside .env.public/.env.admin). Defaults to http://localhost:8787 in dev.
VITE_API_URL=

# Optional build-time defaults for the CRM endpoint the contact forms POST to.
# These are only used as a fallback when no endpoint is set in /admin/settings.
VITE_CRM_API_URL=
VITE_CRM_API_KEY=
